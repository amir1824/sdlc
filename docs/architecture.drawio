<mxfile host="drawio">
  <diagram id="sdlc-plugin" name="sdlc 0.4.0">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="sdlc plugin 0.4.0: the parts and how they connect" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1460" height="30" as="geometry"/></mxCell><mxCell id="owner" value="Owner" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;outlineConnect=0;labelPerimeter=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="36" height="66" as="geometry"/></mxCell><mxCell id="hk" value="The gate: hooks/hooks.json" style="swimlane;startSize=28;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#faf7fc;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="160" y="60" width="750" height="195" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;UserPromptSubmit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;sdlc_gate.py prompt&lt;br&gt;locks: /sdlc&lt;br&gt;unlocks: approve plan&lt;br&gt;releases: sdlc off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="hk"><mxGeometry x="15" y="40" width="230" height="140" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;Gate state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;~/.claude/sdlc-gate/&lt;br&gt;&amp;lt;session&amp;gt;.locked&lt;br&gt;&amp;lt;session&amp;gt;.approved&lt;br&gt;(plan.md hashes)&lt;br&gt;approvals.log&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="hk"><mxGeometry x="275" y="40" width="170" height="140" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;PreToolUse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;sdlc_gate.py tool&lt;br&gt;Edit, Write, MultiEdit, NotebookEdit, Bash&lt;br&gt;denies code until the plan is approved&lt;br&gt;denies fix: without Evidence:&lt;br&gt;denies Bash writes while locked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="hk"><mxGeometry x="475" y="40" width="260" height="140" as="geometry"/></mxCell><mxCell id="e_h1_st" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="hk" source="h1" target="st"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_st_h2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="hk" source="st" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pp" value="/sdlc: nine stages, one handoff file per stage" style="swimlane;startSize=28;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f5f9fe;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="160" y="300" width="750" height="425" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1 · Discover&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;user-researcher&lt;br&gt;research.md or intent.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pp"><mxGeometry x="12" y="40" width="215" height="104" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2 · Define&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;product-manager, then analyst&lt;br&gt;prd.md and metrics.md&lt;br&gt;&lt;b&gt;STOP&lt;/b&gt;: owner approves scope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pp"><mxGeometry x="267" y="40" width="215" height="104" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3 · Design&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;product-designer&lt;br&gt;design-spec.md&lt;br&gt;skipped without a UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pp"><mxGeometry x="522" y="40" width="215" height="104" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4 · Plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;tech-lead, then security-reviewer&lt;br&gt;plan.md, reads the lessons&lt;br&gt;HIGH adds: Must not happen&lt;br&gt;&lt;b&gt;STOP&lt;/b&gt;: reply approve plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pp"><mxGeometry x="522" y="172" width="215" height="104" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5 · Build&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;backend-developer,&lt;br&gt;frontend-developer&lt;br&gt;code and build.md&lt;br&gt;fixes what it breaks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pp"><mxGeometry x="267" y="172" width="215" height="104" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;6 · Verify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;qa-engineer, brutal-reviewer,&lt;br&gt;security-reviewer&lt;br&gt;review.md with test runs&lt;br&gt;BLOCK goes back to Build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pp"><mxGeometry x="12" y="172" width="215" height="104" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;7 · Ship&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;devops-engineer, docs-engineer,&lt;br&gt;leak-scanner&lt;br&gt;release.md&lt;br&gt;whole suite runs once&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pp"><mxGeometry x="12" y="304" width="215" height="104" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;8 · Launch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;/campaign, when installed&lt;br&gt;launch.md&lt;br&gt;drafts only, owner publishes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pp"><mxGeometry x="267" y="304" width="215" height="104" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;9 · Learn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;analyst, on the readout date&lt;br&gt;learn.md&lt;br&gt;moved, did not move, or unknown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pp"><mxGeometry x="522" y="304" width="215" height="104" as="geometry"/></mxCell><mxCell id="p12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="pp" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="pp" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="pp" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="pp" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;exitX=0;exitY=0.3;entryX=1;entryY=0.3;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="pp" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b65" value="back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;fontColor=#B20000;fontSize=12;exitX=1;exitY=0.75;entryX=0;entryY=0.75;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="pp" source="s6" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="pp" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="pp" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p89" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="pp" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lp" value="Improvement loop: lesson, A/B eval, promotion to an agent" style="swimlane;startSize=28;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f7fbf5;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="560" height="670" as="geometry"/></mxCell><mxCell id="ab" value="&lt;b&gt;A/B eval of a lesson&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;lesson-l1-with vs&lt;br&gt;lesson-l1-without&lt;br&gt;at least 3 runs per arm&lt;br&gt;my-agents-plugin/evals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lp"><mxGeometry x="15" y="50" width="235" height="130" as="geometry"/></mxCell><mxCell id="evb" value="&lt;b&gt;Agent eval cases&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;in my-agents-plugin/evals&lt;br&gt;e.g. backend-developer-minimal-diff&lt;br&gt;check an agent still does its job&lt;br&gt;and a promotion works without the lesson&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lp"><mxGeometry x="310" y="50" width="235" height="130" as="geometry"/></mxCell><mxCell id="rate" value="&lt;b&gt;rate_lesson.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;in the repo&lt;br&gt;helped: confidence medium&lt;br&gt;hurt: status retired&lt;br&gt;under 3 runs or error: confounded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lp"><mxGeometry x="15" y="255" width="235" height="104" as="geometry"/></mxCell><mxCell id="agents" value="&lt;b&gt;Agent files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;plugins/sdlc/agents/*.md&lt;br&gt;same copy in my-agents-plugin,&lt;br&gt;where the evals run&lt;br&gt;the next run uses the new one&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lp"><mxGeometry x="310" y="255" width="235" height="104" as="geometry"/></mxCell><mxCell id="les" value="&lt;b&gt;Lessons library&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;~/.claude/lessons/LESSONS.md&lt;br&gt;proposed · library · promoted&lt;br&gt;retired when a lesson hurt&lt;br&gt;tech-lead skips proposed, retired&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lp"><mxGeometry x="15" y="409" width="235" height="110" as="geometry"/></mxCell><mxCell id="promo" value="&lt;b&gt;Promotion to an agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;only helped, and the owner's yes&lt;br&gt;the lesson text enters the&lt;br&gt;agent file, status: promoted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lp"><mxGeometry x="310" y="409" width="235" height="110" as="geometry"/></mxCell><mxCell id="retro" value="&lt;b&gt;retro.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;at the end of a run&lt;br&gt;a used lesson: confounded&lt;br&gt;(one run has no contrast)&lt;br&gt;a new lesson: proposed until yes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lp"><mxGeometry x="15" y="544" width="235" height="104" as="geometry"/></mxCell><mxCell id="example" value="&lt;b&gt;Example: L1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;helped: with 3/3, without 0/3&lt;br&gt;promoted to backend- and&lt;br&gt;frontend-developer&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lp"><mxGeometry x="310" y="544" width="235" height="104" as="geometry"/></mxCell><mxCell id="d_ab_rate" value="result.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="lp" source="ab" target="rate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_rate_les" value="used line" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="lp" source="rate" target="les"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_retro_les" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="lp" source="retro" target="les"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_les_promo" value="helped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2D7600;fontColor=#2D7600;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="lp" source="les" target="promo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_promo_agents" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="lp" source="promo" target="agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_agents_evb" value="promotion check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="lp" source="agents" target="evb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b_rate_agents" value="hurt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#b85450;fontColor=#B20000;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;verticalAlign=bottom;labelPlacement=auto;" edge="1" parent="lp" source="rate" target="agents"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="files" value="&lt;b&gt;Handoff files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;.sdlc/&amp;lt;slug&amp;gt;/&lt;br&gt;research/intent · prd · metrics&lt;br&gt;design-spec · plan · build&lt;br&gt;review · release · launch · learn&lt;br&gt;status · retro: the run's memory&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="160" y="775" width="340" height="130" as="geometry"/></mxCell><mxCell id="cm" value="More commands, and an agent without a command" style="swimlane;startSize=28;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#fafafa;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="540" y="775" width="680" height="130" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;/brutal-review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;brutal-reviewer on the diff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cm"><mxGeometry x="15" y="38" width="200" height="80" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;/security-audit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;security-reviewer and&lt;br&gt;leak-scanner, in parallel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cm"><mxGeometry x="240" y="38" width="200" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;refactor-engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;improves code, same behavior&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="cm"><mxGeometry x="465" y="38" width="200" height="80" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Repo only, not in the plugin&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;rules/: installed by install.sh&lt;br&gt;check.sh: install drift, hook wiring&lt;br&gt;rate_lesson.py and tests/&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1260" y="775" width="240" height="130" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend:&lt;/b&gt; solid line: flow · dashed: reads or writes a file · red dashed: going back, a failed stage or a lesson that hurt&lt;br&gt;yellow: the owner approves · purple: hooks · green: state and files · orange: outside the plugin" style="text;html=1;fontSize=12;align=center;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="160" y="925" width="1340" height="45" as="geometry"/></mxCell><mxCell id="f_owner_h1" value="types" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="owner" target="h1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_owner_pp" value="yes at each STOP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;fontSize=12;exitX=0.5;exitY=1;entryX=0;entryY=0.45;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="owner" target="pp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_h2_pp" value="denies code until approval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=12;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="h2" target="pp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_pp_files" value="each stage writes a file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;fontSize=12;exitX=0.2267;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;labelPlacement=auto;" edge="1" parent="1" source="pp" target="files"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_s9_retro" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="s9" target="retro"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_les_s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#82b366;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="les" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
