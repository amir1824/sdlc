{
  "description": "sdlc gates: no code before the owner approves the plan, no MCP write and no approval before the ticket's label was seen in a Jira run, Evidence: on fix commits, read-only review agents stay read-only, a fix's reproduction tests are frozen for everyone but qa-engineer, a compaction in a run keeps the run's place, and a Snyk scan of the project is recorded",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.py\" prompt", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.py\" tool", "timeout": 5 }
        ]
      },
      {
        "matcher": "^mcp__",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.py\" mcp", "timeout": 5 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.py\" precompact || exit 0", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.py\" compacted", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/status_check.py\" hook", "timeout": 5 }
        ]
      },
      {
        "matcher": "^mcp__.*(getJiraIssue|executeRead|execute_read|jira_get_issue)",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.py\" jira-seen", "timeout": 5 }
        ]
      },
      {
        "matcher": "^mcp__.*__snyk_(code|sca|iac)_scan$",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.py\" snyk-seen", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__.*__snyk_(code|sca|iac)_scan$",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc_gate.py\" snyk-seen", "timeout": 5 }
        ]
      }
    ]
  }
}
